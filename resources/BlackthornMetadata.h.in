#pragma once

#include "Core/MetadataConfig.h"

namespace Blackthorn::Generated {

/**
 * @brief Build-time-generated metadata for the "@TARGET_NAME@" target.
 *
 * @details
 * Generated by target_add_platform_resources() from
 * resources/BlackthornMetadata.h.in, from the same BT_META_* target
 * properties used to generate this target's platform resource
 * (app.rc / Info.plist / .desktop). This keeps the OS-level packaging
 * identity and the runtime SDL_SetAppMetadataProperty() values as a
 * single source of truth.
 *
 * @note Do not edit this file - it is regenerated on every configure.
 *       Change the target_set_metadata(@TARGET_NAME@ ...) call in the
 *       owning CMakeLists.txt instead.
 */
inline MetadataConfig getMetadataConfig() {
	MetadataConfig cfg;
	cfg.name       = "@NAME@";
	cfg.version    = "@VERSION@";
	cfg.identifier = "@IDENTIFIER@";
	cfg.author     = "@AUTHOR@";
	cfg.copyright  = "@COPYRIGHT@";
	cfg.url        = "@URL@";
	cfg.type       = "@TYPE@";
	return cfg;
}

} // namespace Blackthorn::Generated

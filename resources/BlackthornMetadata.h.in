#pragma once

#include "Core/MetadataConfig.h"

namespace Blackthorn::Generated {

/**
 * @brief Build-time-generated metadata for the "@TARGET_NAME@" target.
 *
 * @details
 * Generated by target_add_platform_resources() from
 * resources/BlackthornMetadata.h.in, using the same BT_META_* target
 * properties that generate this target's platform resource
 * (app.rc / Info.plist / .desktop). This keeps the OS-level packaging
 * identity and runtime SDL_SetAppMetadataProperty() values in sync.
 *
 * @note Do not edit this file. It is regenerated on every configure.
 *       To change the metadata, update the target_set_metadata(@TARGET_NAME@ ...)
 *       call in the owning CMakeLists.txt instead.
 */
inline MetadataConfig getMetadataConfig() {
	MetadataConfig cfg;
	cfg.name       = "@NAME@";
	cfg.version    = "@VERSION@";
	cfg.identifier = "@IDENTIFIER@";
	cfg.author     = "@AUTHOR@";
	cfg.copyright  = "@COPYRIGHT@";
	cfg.url        = "@URL@";
	cfg.type       = "@TYPE@";
	return cfg;
}

} // namespace Blackthorn::Generated
